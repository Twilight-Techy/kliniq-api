# App Settings
APP_ENV="development"
DEBUG=True
FRONTEND_URL="http://localhost:3000"
SUPPORT_URL="http://localhost:3000/support"

# Database URLs (e.g., from Neon or locally)
# Use asyncpg for the application and psycopg2 for Alembic migrations
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/kliniq"
ALEMBIC_DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/kliniq"

# JWT Authentication
JWT_SECRET="generate-a-long-random-string-here"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=1440

# CORS Setting (comma-separated list of origins)
ALLOWED_ORIGINS="http://localhost:3000"

# Logging & Render settings
LOG_LEVEL="info"
RENDER_EXTERNAL_URL=

# LLM Provider (options: "gemini" or "natlas")
# Defaulting to gemini as it is easier to setup
LLM_PROVIDER="gemini"
GOOGLE_API_KEY="your-google-api-key-here"

# N-ATLaS / Modal settings (only needed if LLM_PROVIDER=natlas)
MODAL_ENDPOINT_URL=""
MODAL_ASR_URL=""

# Vercel Blob (for voice recordings storage)
BLOB_READ_WRITE_TOKEN=""

# Email settings
EMAIL_SENDER="your-email@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
CONTACT_RECIPIENT="recipient-email@gmail.com"
